/**
 * @file firestore.rules
 * @description Security rules for the "Complejo deportivo Area41" Firestore database.
 *
 * @version 1.1.0
 *
 * @philosophy
 * This ruleset implements a mixed security model tailored for a sports complex application.
 * - User-Private Data: Data like user profiles and reservations are strictly private, accessible only by the document owner.
 * - Public Data: Shared information like court availability, buffet menus, and tournaments are publicly readable by any user.
 * - Admin-Write Data: Public data can only be written to by users flagged as administrators (`isAdmin: true`).
 * - Write Restrictions: Normal users can only write to their own data.
 *
 * @structure
 * The data is organized into logical top-level collections for each major entity.
 * User-specific data is secured by checking an ownership field (e.g., `userId`).
 * Admin privileges are checked by reading the user's profile from `/users/{userId}`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the given userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the currently authenticated user's UID matches the 'userId' field
     * on a document.
     */
    function isDocumentOwner(doc) {
      return isSignedIn() && request.auth.uid == doc.userId;
    }

    /**
     * Checks if the requesting user is an administrator.
     * Reads the user's profile to check the `isAdmin` flag.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }


    // -------------------------------------------------------------------------
    // User Profiles (/users)
    // -------------------------------------------------------------------------

    /**
     * @description Rules for a user's own profile document.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Only a user can create their own profile. `isAdmin` can't be set to true on creation by a non-admin.
      allow create: if isOwner(userId) && request.resource.data.isAdmin == false;
      // A user can update their own profile. Only an admin can change the `isAdmin` status.
      allow update: if (isOwner(userId) && request.resource.data.isAdmin == resource.data.isAdmin) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Public, Admin-Managed Collections
    // -------------------------------------------------------------------------

    /**
     * Generic rules for collections that are publicly readable but only
     * writable by administrators.
     */
    function publicReadAdminWrite() {
      return {
        'allow get': if true,
        'allow list': if true,
        'allow create, update, delete': if isAdmin()
      }
    }

    /**
     * @description Rules for Courts. Publicly readable, admin-managed.
     */
    match /courts/{courtId} {
        allow get: if true;
        allow list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Menu Items. Publicly readable, admin-managed.
     */
    match /menu_items/{menuItemId} {
        allow get: if true;
        allow list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Tournaments. Publicly readable, admin-managed.
     */
    match /tournaments/{tournamentId} {
        allow get: if true;
        allow list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Teams. Publicly readable, admin-managed.
     */
    match /teams/{teamId} {
        allow get: if true;
        allow list: if true;
        allow create, update, delete: if isAdmin();
    }


    // -------------------------------------------------------------------------
    // Reservations (/reservations)
    // -------------------------------------------------------------------------

    /**
     * @description Rules for court reservations made by users.
     * @path /reservations/{reservationId}
     */
    match /reservations/{reservationId} {
      allow get: if isSignedIn() && (isDocumentOwner(resource.data) || isAdmin());
      // Listing is intentionally disabled for general users to prevent data leakage.
      // Availability checks should be done by attempting a write and handling the failure.
      allow list: if isAdmin();
      allow create: if isSignedIn() && isDocumentOwner(request.resource.data);
      allow update: if isSignedIn() && ((isDocumentOwner(resource.data) && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (isDocumentOwner(resource.data) || isAdmin());
    }
  }
}

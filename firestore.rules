
/**
 * @file firestore.rules
 * @description Security rules for the "Complejo deportivo Area41" Firestore database.
 *
 * @version 1.9.0
 *
 * @philosophy
 * This ruleset implements a mixed security model tailored for a sports complex application.
 * - User-Private Data: Data like user profiles are strictly private, accessible only by the document owner.
 * - Publicly Readable Data: Shared information like court availability, buffet menus, and tournaments are publicly readable by any user.
 * - Admin-Write Data: Public data can only be written to by users flagged as administrators (`isAdmin: true`).
 * - Reservation Logic:
 *   - Users can only create reservations for themselves.
 *   - Any authenticated user can LIST reservations to check for availability.
 *   - Users can only GET, UPDATE, or DELETE their own reservations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the given userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the currently authenticated user's UID matches the 'userId' field
     * on a document.
     */
    function isDocumentOwner(doc) {
      return isSignedIn() && request.auth.uid == doc.userId;
    }

    /**
     * Checks if the requesting user is an administrator.
     * Reads the user's profile to check the `isAdmin` flag.
     */
    function isAdmin() {
      // Safely check for the existence of the user document and the isAdmin flag.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    /**
     * Checks if the incoming request data for a user profile is valid.
     */
    function isValidUserCreate(userId) {
      let incomingData = request.resource.data;
      
      // The user must be creating their own document.
      if (!isOwner(userId)) {
        return false;
      }
      
      // A normal user cannot set themselves as admin.
      if (incomingData.get('isAdmin', false) == true) {
        // Exception: Allow a specific email to become an admin on creation.
        return request.auth.token.email == 'matias@vascohogar.com';
      }
      
      // If not trying to set isAdmin, the creation is valid for any user.
      return true;
    }

    /**
     * Checks if the incoming request data for a user profile update is valid.
     */
    function isValidUserUpdate(userId) {
        // An admin can update anything on any user's profile.
        if (isAdmin()) {
            return true;
        }
        
        // A user can update their own profile.
        if (isOwner(userId)) {
            // Check if they are trying to change their admin status.
            let isTryingToBecomeAdmin = request.resource.data.get('isAdmin', false) == true && resource.data.get('isAdmin', false) == false;
            
            if (isTryingToBecomeAdmin) {
                // Only allow the special email to grant themselves admin rights.
                return request.auth.token.email == 'matias@vascohogar.com';
            } else {
                // Allow update if they are not changing their admin status, or if an admin is demoting them.
                // The isAdmin() check at the top already covers admins, so this path is for non-admins.
                // A non-admin cannot change the isAdmin flag.
                return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
            }
        }
        
        return false;
    }


    // -------------------------------------------------------------------------
    // User Profiles (/users)
    // -------------------------------------------------------------------------

    /**
     * @description Rules for a user's own profile document.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isValidUserCreate(userId);
      allow update: if isValidUserUpdate(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Public, Read-Only Collections
    // -------------------------------------------------------------------------

    /**
     * @description Rules for Courts. Publicly readable, admin-managed.
     */
    match /courts/{courtId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Menu Items. Publicly readable, admin-managed.
     */
    match /menu_items/{menuItemId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Tournaments. Publicly readable, admin-managed.
     */
    match /tournaments/{tournamentId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Teams. Publicly readable, admin-managed.
     */
    match /teams/{teamId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }


    // -------------------------------------------------------------------------
    // Reservations (/reservations)
    // -------------------------------------------------------------------------

    /**
     * @description Rules for court reservations made by users.
     * @path /reservations/{reservationId}
     */
    match /reservations/{reservationId} {
      // A user can read their own reservation. Admins can read any.
      allow get: if isSignedIn() && (isDocumentOwner(resource.data) || isAdmin());
      // Any signed-in user can list reservations to check for availability.
      // The client-side code will only query for the current day and won't expose sensitive data.
      allow list: if isSignedIn();
      // A user can only create a reservation for themselves.
      allow create: if isSignedIn() && isDocumentOwner(request.resource.data);
      // A user can only update their own reservation, and cannot change the owner. Admins can update any.
      allow update: if isSignedIn() && ((isDocumentOwner(resource.data) && request.resource.data.userId == resource.data.userId) || isAdmin());
       // A user can delete their own reservation. Admins can delete any.
      allow delete: if isSignedIn() && (isDocumentOwner(resource.data) || isAdmin());
    }
  }
}


rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Default rule: Allows read and write access to any authenticated user.
     * This is a simple rule for trusted users (e.g., an app for friends).
     */
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}

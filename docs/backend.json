{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the sports complex application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Indicates if the user is an administrator."
        },
        "cancellationCount": {
          "type": "number",
          "description": "Number of times the user has cancelled a reservation."
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "phoneNumber",
        "email"
      ]
    },
    "Court": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Court",
      "type": "object",
      "description": "Represents a sports court available for reservation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the court."
        },
        "courtType": {
          "type": "string",
          "description": "Type of court (e.g., Futbol 5, Futbol 7)."
        },
        "courtNumber": {
          "type": "number",
          "description": "The number of the court."
        },
        "price": {
          "type": "number",
          "description": "The hourly price for reserving the court."
        },
        "isAvailable": {
          "type": "boolean",
          "description": "Indicates if the court is currently available."
        }
      },
      "required": [
        "id",
        "courtType",
        "courtNumber",
        "isAvailable",
        "price"
      ]
    },
    "Reservation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Reservation",
      "type": "object",
      "description": "Represents a reservation made by a user for a court.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the reservation."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "courtIds": {
          "type": "array",
          "description": "Reference to Court IDs.",
          "items": {
            "type": "string"
          }
        },
        "reservationDateTime": {
          "type": "string",
          "description": "Date and time of the reservation.",
          "format": "date-time"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration of the reservation in minutes."
        }
      },
      "required": [
        "id",
        "userId",
        "courtIds",
        "reservationDateTime",
        "durationMinutes"
      ]
    },
    "MenuItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItem",
      "type": "object",
      "description": "Represents an item available in the buffet.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the menu item."
        },
        "name": {
          "type": "string",
          "description": "Name of the menu item."
        },
        "description": {
          "type": "string",
          "description": "Description of the menu item."
        },
        "price": {
          "type": "number",
          "description": "Price of the menu item."
        },
        "type": {
          "type": "string",
          "description": "Type of menu item (e.g., beverage, food)."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the item image."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "price",
        "type"
      ]
    },
    "FixedReservation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FixedReservation",
      "type": "object",
      "description": "Represents a recurring, fixed reservation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the fixed reservation."
        },
        "courtId": {
          "type": "string",
          "description": "The ID of the court."
        },
        "dayOfWeek": {
          "type": "number",
          "description": "Day of the week (0-6)."
        },
        "time": {
          "type": "string",
          "description": "Time in HH:mm format."
        },
        "clientName": {
          "type": "string",
          "description": "Name of the client."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number."
        },
        "isActive": {
          "type": "boolean",
          "description": "Is active."
        }
      },
      "required": [
        "id",
        "courtId",
        "dayOfWeek",
        "time",
        "clientName",
        "isActive"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/courts/{courtId}",
        "definition": {
          "entityName": "Court",
          "schema": {
            "$ref": "#/backend/entities/Court"
          },
          "description": "Stores information about available courts."
        }
      },
      {
        "path": "/reservations/{reservationId}",
        "definition": {
          "entityName": "Reservation",
          "schema": {
            "$ref": "#/backend/entities/Reservation"
          },
          "description": "Stores reservation details."
        }
      },
      {
        "path": "/menu_items/{menuItemId}",
        "definition": {
          "entityName": "MenuItem",
          "schema": {
            "$ref": "#/backend/entities/MenuItem"
          },
          "description": "Stores the menu items."
        }
      },
      {
        "path": "/fixed_reservations/{fixedReservationId}",
        "definition": {
          "entityName": "FixedReservation",
          "schema": {
            "$ref": "#/backend/entities/FixedReservation"
          },
          "description": "Stores recurring fixed reservations."
        }
      }
    ],
    "reasoning": "Data structure to support Area41 core features including fixed reservations and user history."
  }
}

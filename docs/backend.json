{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the sports complex application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Indicates if the user is an administrator."
        },
        "cancellationCount": {
          "type": "number",
          "description": "Number of times the user has cancelled a reservation."
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "phoneNumber",
        "email"
      ]
    },
    "Court": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Court",
      "type": "object",
      "description": "Represents a sports court available for reservation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the court."
        },
        "courtType": {
          "type": "string",
          "description": "Type of court (e.g., Futbol 5, Futbol 7)."
        },
        "courtNumber": {
          "type": "number",
          "description": "The number of the court."
        },
        "price": {
          "type": "number",
          "description": "The hourly price for reserving the court."
        },
        "isAvailable": {
          "type": "boolean",
          "description": "Indicates if the court is currently available."
        }
      },
      "required": [
        "id",
        "courtType",
        "courtNumber",
        "isAvailable",
        "price"
      ]
    },
    "Reservation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Reservation",
      "type": "object",
      "description": "Represents a reservation made by a user for a court.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the reservation."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "courtIds": {
          "type": "array",
          "description": "Reference to Court IDs.",
          "items": {
            "type": "string"
          }
        },
        "reservationDateTime": {
          "type": "string",
          "description": "Date and time of the reservation.",
          "format": "date-time"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration of the reservation in minutes."
        }
      },
      "required": [
        "id",
        "userId",
        "courtIds",
        "reservationDateTime",
        "durationMinutes"
      ]
    },
    "Advertisement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Advertisement",
      "type": "object",
      "description": "Represents a publicity image shown on the home page.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "title": {
          "type": "string",
          "description": "Title of the advertisement."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the image."
        },
        "isActive": {
          "type": "boolean",
          "description": "Is it visible?"
        }
      },
      "required": [
        "id",
        "title",
        "imageUrl",
        "isActive"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/courts/{courtId}",
        "definition": {
          "entityName": "Court",
          "schema": {
            "$ref": "#/backend/entities/Court"
          },
          "description": "Stores information about available courts."
        }
      },
      {
        "path": "/reservations/{reservationId}",
        "definition": {
          "entityName": "Reservation",
          "schema": {
            "$ref": "#/backend/entities/Reservation"
          },
          "description": "Stores reservation details."
        }
      },
      {
        "path": "/advertisements/{adId}",
        "definition": {
          "entityName": "Advertisement",
          "schema": {
            "$ref": "#/backend/entities/Advertisement"
          },
          "description": "Stores publicity images."
        }
      }
    ],
    "reasoning": "Soporte para usuarios, canchas, reservas y publicidad administrable."
  }
}
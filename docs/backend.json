
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the sports complex application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Indicates if the user is an administrator."
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "phoneNumber",
        "email"
      ]
    },
    "Court": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Court",
      "type": "object",
      "description": "Represents a sports court available for reservation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the court."
        },
        "courtType": {
          "type": "string",
          "description": "Type of court (e.g., Futbol 5, Futbol 7)."
        },
        "courtNumber": {
          "type": "number",
          "description": "The number of the court."
        },
        "price": {
          "type": "number",
          "description": "The hourly price for reserving the court."
        },
        "isAvailable": {
          "type": "boolean",
          "description": "Indicates if the court is currently available."
        }
      },
      "required": [
        "id",
        "courtType",
        "courtNumber",
        "isAvailable",
        "price"
      ]
    },
    "Reservation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Reservation",
      "type": "object",
      "description": "Represents a reservation made by a user for a court.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the reservation."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Reservation)"
        },
        "courtIds": {
          "type": "array",
          "description": "Reference to Court. (Relationship: Court 1:N Reservation)",
          "items": {
            "type": "string"
          }
        },
        "reservationDateTime": {
          "type": "string",
          "description": "Date and time of the reservation.",
          "format": "date-time"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration of the reservation in minutes."
        },
        "videoUrl": {
            "type": "string",
            "description": "URL to the recorded match video."
        }
      },
      "required": [
        "id",
        "userId",
        "courtIds",
        "reservationDateTime",
        "durationMinutes"
      ]
    },
    "MenuItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItem",
      "type": "object",
      "description": "Represents an item available in the buffet.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the menu item."
        },
        "name": {
          "type": "string",
          "description": "Name of the menu item."
        },
        "description": {
          "type": "string",
          "description": "Description of the menu item."
        },
        "price": {
          "type": "number",
          "description": "Price of the menu item."
        },
        "type": {
          "type": "string",
          "description": "Type of menu item (e.g., beverage, food)."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "price",
        "type"
      ]
    },
    "BackgroundImage": {
      "title": "BackgroundImage",
      "type": "object",
      "description": "Represents a background image for the application.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the background image." },
        "name": { "type": "string", "description": "Name or title of the image." },
        "imageUrl": { "type": "string", "description": "URL of the image." },
        "isActive": { "type": "boolean", "description": "Indicates if the image is the active background." }
      },
      "required": ["id", "name", "imageUrl", "isActive"]
    },
     "LogoImage": {
      "title": "LogoImage",
      "type": "object",
      "description": "Represents a logo image for the application.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the logo." },
        "name": { "type": "string", "description": "Name or title of the logo." },
        "imageUrl": { "type": "string", "description": "URL of the logo image." },
        "isActive": { "type": "boolean", "description": "Indicates if the logo is the active one." }
      },
      "required": ["id", "name", "imageUrl", "isActive"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information. Accessible only by the authenticated user."
        }
      },
      {
        "path": "/courts/{courtId}",
        "definition": {
          "entityName": "Court",
          "schema": {
            "$ref": "#/backend/entities/Court"
          },
          "description": "Stores information about available courts."
        }
      },
      {
        "path": "/reservations/{reservationId}",
        "definition": {
          "entityName": "Reservation",
          "schema": {
            "$ref": "#/backend/entities/Reservation"
          },
          "description": "Stores reservation details. Includes userId and courtIds for authorization independence."
        }
      },
      {
        "path": "/menu_items/{menuItemId}",
        "definition": {
          "entityName": "MenuItem",
          "schema": {
            "$ref": "#/backend/entities/MenuItem"
          },
          "description": "Stores the menu items offered by the buffet."
        }
      },
       {
        "path": "/background_images/{imageId}",
        "definition": {
          "entityName": "BackgroundImage",
          "schema": {
            "$ref": "#/backend/entities/BackgroundImage"
          },
          "description": "Stores background images for the application."
        }
      },
      {
        "path": "/logo_images/{logoId}",
        "definition": {
          "entityName": "LogoImage",
          "schema": {
            "$ref": "#/backend/entities/LogoImage"
          },
          "description": "Stores logo images for the application."
        }
      }
    ],
    "reasoning": "The Firestore data structure is designed to support the sports complex application's core features. The tournament-related collections have been removed as per the user's request."
  }
}

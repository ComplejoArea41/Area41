
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if a user is an administrator
    function isAdmin() {
      // Assumes user profile with 'isAdmin' flag is stored in Firestore
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for background images
    match /backgrounds/{imageName} {
      // Anyone can read (view) the background images
      allow read: if true;
      
      // Only administrators can upload (create), update, or delete background images
      allow write: if request.auth != null && isAdmin();
    }
    
    // Rules for logo images
    match /logos/{logoName} {
      // Anyone can read (view) the logo images
      allow read: if true;
      
      // Only administrators can upload (create), update, or delete logo images
      allow write: if request.auth != null && isAdmin();
    }
    
    // Default-deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
